  decide (569 ≤ q ∨ q < 3 ∨ q % 2 = 0 ∨ q ∈ smallOddPrimes102 ∨
    q % 3 = 0 ∨ q % 5 = 0 ∨ q % 7 = 0 ∨ q % 11 = 0 ∨
    q % 13 = 0 ∨ q % 17 = 0 ∨ q % 19 = 0 ∨ q % 23 = 0)

lemma allRange_checkSmallOdd569 : allRangePow2 checkSmallOdd569 10 0 = true := rfl

lemma mem_smallOddPrimes102_of_odd_prime {q : ℕ} (hq : Nat.Prime q) (hodd : Odd q)
    (hlt : q < 569) : q ∈ smallOddPrimes102 := by
  have hall := allRangePow2_sound checkSmallOdd569 10 0 q
    allRange_checkSmallOdd569 (Nat.zero_le q) (by norm_num; omega)
  unfold checkSmallOdd569 at hall
  simp only [decide_eq_true_eq] at hall
  have hq3 : 3 ≤ q := by
    have h2 := hq.two_le
    rcases hodd with ⟨t, hqt⟩
    omega
  have hmod1 : q % 2 = 1 := Nat.odd_iff.mp hodd
  have hmem_of_dvd : ∀ r : ℕ, Nat.Prime r → r ∈ smallOddPrimes102 → q % r = 0 →
      q ∈ smallOddPrimes102 := by
    intro r hr hrmem hmod
    have hdvd : r ∣ q := Nat.dvd_of_mod_eq_zero hmod
    have heq : r = q := (Nat.prime_dvd_prime_iff_eq hr hq).mp hdvd
    exact heq ▸ hrmem
  rcases hall with h | h | h | h | h3 | h5 | h7 | h11 | h13 | h17 | h19 | h23
  · omega
  · omega
  · omega
  · exact h
  · exact hmem_of_dvd 3 (by decide) (by decide) h3
  · exact hmem_of_dvd 5 (by decide) (by decide) h5
  · exact hmem_of_dvd 7 (by decide) (by decide) h7
  · exact hmem_of_dvd 11 (by decide) (by decide) h11
  · exact hmem_of_dvd 13 (by decide) (by decide) h13
  · exact hmem_of_dvd 17 (by decide) (by decide) h17
  · exact hmem_of_dvd 19 (by decide) (by decide) h19
  · exact hmem_of_dvd 23 (by decide) (by decide) h23

lemma minFac_sq_le_of_not_prime {n : ℕ} (hn2 : 2 ≤ n) (hnp : ¬ Nat.Prime n) :
    n.minFac * n.minFac ≤ n := by
  set q := n.minFac
  have hq_pr : Nat.Prime q := Nat.minFac_prime (by omega)
  have hq_dvd : q ∣ n := Nat.minFac_dvd n
  rcases hq_dvd with ⟨m, hm⟩
  have hm2 : 2 ≤ m := by
    rcases m with _ | _ | m'
    · omega
    · exfalso; apply hnp; simpa [hm] using hq_pr
    · omega
  have hm_pr : Nat.Prime m.minFac := Nat.minFac_prime (by omega)
  have hm_dvd_n : m.minFac ∣ n := by
    rw [hm]
    exact dvd_mul_of_dvd_right (Nat.minFac_dvd m) q
  have hq_le_mf : q ≤ m.minFac := Nat.minFac_le_of_dvd hm_pr.two_le hm_dvd_n
  have hmf_le_m : m.minFac ≤ m := Nat.minFac_le (by omega)
  have hq_le_m : q ≤ m := le_trans hq_le_mf hmf_le_m
  calc q * q ≤ q * m := Nat.mul_le_mul_left q hq_le_m
    _ = n := hm.symm

lemma prime_of_sieveComp321145_false {k : ℕ} (hk2 : 2 ≤ k) (hkle : k ≤ 160571)
    (hfalse : sieveComp321145.testBit k = false) :
    Nat.Prime (2 * k + 1) := by
  set p := 2 * k + 1
  have hp_le : p ≤ 321143 := by dsimp only [p]; omega
  by_contra hnp
  set q := p.minFac
  have hq_pr : Nat.Prime q := Nat.minFac_prime (by omega)
  have hq_dvd : q ∣ p := Nat.minFac_dvd p
  have hq_sq : q * q ≤ p := minFac_sq_le_of_not_prime (by omega) hnp
  have hq_lt : q < 569 := by nlinarith
  have hp_odd : Odd p := ⟨k, rfl⟩
  have hq_odd : Odd q := Odd.of_dvd_nat hp_odd hq_dvd
  have hq_mem : q ∈ smallOddPrimes102 := mem_smallOddPrimes102_of_odd_prime hq_pr hq_odd hq_lt
  have hq3 : 3 ≤ q := by
    have h2 := hq_pr.two_le
    rcases hq_odd with ⟨tq, hqt⟩
    omega
  rcases hq_dvd with ⟨m, hm⟩
  have hm_odd : Odd m := Odd.of_dvd_nat hp_odd ⟨q, by rw [hm, mul_comm]⟩
  have hq_le_m : q ≤ m := by nlinarith
  set j := (m - q) / 2
  have hm_eq : m = q + 2 * j := by
    rcases hq_odd with ⟨tq, hqt⟩
    rcases hm_odd with ⟨tm, hmt⟩
    dsimp only [j]
    omega
  have hqq_odd : Odd (q * q) := hq_odd.mul hq_odd
  have hk_eq : k = (q * q - 1) / 2 + q * j := by
    have hp_eq : 2 * k + 1 = q * q + 2 * (q * j) := by
      calc 2 * k + 1 = p := rfl
        _ = q * m := hm
        _ = q * (q + 2 * j) := by rw [hm_eq]
        _ = q * q + 2 * (q * j) := by ring
    rcases hqq_odd with ⟨t, ht⟩
    have hhalf : (q * q - 1) / 2 = t := by omega
    rw [hhalf]
    rw [ht] at hp_eq
    generalize q * j = qj at hp_eq ⊢
    omega
  have hj_lt : j < 160573 / q + 1 := by
    have hqj : j * q ≤ 160573 := by rw [mul_comm]; omega
    have hle_div : j ≤ 160573 / q :=
      (Nat.le_div_iff_mul_le (by omega : 0 < q)).mpr hqj
    omega
  have hrow :
      (((periodicMask q (160573 / q + 1)) <<< ((q * q - 1) / 2))).testBit k = true := by
    rw [Nat.testBit_shiftLeft]
    have hge : (q * q - 1) / 2 ≤ k := by omega
    have hsub : k - (q * q - 1) / 2 = q * j := by omega
    simp only [hge, decide_true, Bool.true_and, hsub]
    exact testBit_periodicMask_of_lt (by omega) _ j hj_lt
  have hsieve_true : sieveComp321145.testBit k = true :=
    foldl_or_of_mem
      (fun r => (periodicMask r (160573 / r + 1)) <<< ((r * r - 1) / 2))
      smallOddPrimes102 0 k hq_mem hrow
  rw [hfalse] at hsieve_true
  cases hsieve_true

