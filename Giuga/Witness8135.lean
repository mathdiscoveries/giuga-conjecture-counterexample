/-! ### Part 1: Converse Periodic-Bitmask Lemmas & 102-Prime Sieve up to `321,143` -/

lemma testBit_periodicMask_of_lt {q : ℕ} (hq : 1 ≤ q) :
    ∀ m j : ℕ, j < m → (periodicMask q m).testBit (q * j) = true := by
  intro m
  induction m with
  | zero =>
    intro j hj
    omega
  | succ m ih =>
    intro j hj
    rw [(periodicMask_mul_eq q hq m).2]
    rcases j with _ | j'
    · rw [Nat.mul_zero, testBit_eq_decide_div_mod, pow_zero, Nat.div_one]
      have heven : 2 ∣ 2 ^ q := dvd_pow_self 2 (by omega)
      rcases heven with ⟨t, ht⟩
      have hrew : periodicMask q m * (2 * t) + 1 = 2 * (periodicMask q m * t) + 1 := by ring
      have hmod : (periodicMask q m * 2 ^ q + 1) % 2 = 1 := by
        rw [ht, hrew]
        omega
      simp [hmod]
    · have h2q_gt1 : 1 < 2 ^ q := by
        calc 1 < 2 ^ 1 := by norm_num
        _ ≤ 2 ^ q := Nat.pow_le_pow_right (by omega) hq
      have hmul_eq : q * (j' + 1) = q + q * j' := by ring
      rw [hmul_eq, testBit_eq_decide_div_mod, pow_add, ← Nat.div_div_eq_div_mul]
      have hdiv : (periodicMask q m * 2 ^ q + 1) / 2 ^ q = periodicMask q m := by
        rw [add_comm, Nat.add_mul_div_right _ _ (Nat.two_pow_pos q),
          Nat.div_eq_of_lt h2q_gt1, zero_add]
      rw [hdiv, ← testBit_eq_decide_div_mod]
      exact ih j' (by omega)

/-- Shift-optimized conflict-multiple bitmask for `q` covering `m` multiples `q, 2q, …, mq`. -/
def multsMask (q m : ℕ) : ℕ :=
  if m == 0 then 0
  else if m == 1 then 1 <<< q
  else if m == 2 then (1 + (1 <<< q)) <<< q
  else if m == 3 then (1 + (1 <<< q) + (1 <<< (2 * q))) <<< q
  else (periodicMask q m) <<< q

lemma multsMask_eq_shift {q m : ℕ} (hq : 1 ≤ q) :
    multsMask q m = (periodicMask q m) <<< q := by
  unfold multsMask
  have h0 : periodicMask q 0 = 0 := by unfold periodicMask; simp [Nat.one_shiftLeft]
  have h1 : periodicMask q 1 = 1 := by
    rw [(periodicMask_mul_eq q hq 0).2, h0, zero_mul, zero_add]
  have h2 : periodicMask q 2 = 1 + (1 <<< q) := by
    rw [(periodicMask_mul_eq q hq 1).2, h1, one_mul, Nat.one_shiftLeft, add_comm]
  have h3 : periodicMask q 3 = 1 + (1 <<< q) + (1 <<< (2 * q)) := by
    rw [(periodicMask_mul_eq q hq 2).2, h2]
    simp only [Nat.one_shiftLeft]
    rw [mul_comm 2 q, pow_mul]
    ring
  by_cases hm0 : m = 0
  · subst hm0; simp [h0]
  · have hb0 : (m == 0) = false := beq_false_of_ne hm0
    rw [hb0]
    by_cases hm1 : m = 1
    · subst hm1; simp [h1]
    · have hb1 : (m == 1) = false := beq_false_of_ne hm1
      rw [hb1]
      by_cases hm2 : m = 2
      · subst hm2; simp [h2]
      · have hb2 : (m == 2) = false := beq_false_of_ne hm2
        rw [hb2]
        by_cases hm3 : m = 3
        · subst hm3; simp [h3]
        · have hb3 : (m == 3) = false := beq_false_of_ne hm3
          simp [hb3]

lemma testBit_multsMask_of_lt {q m j : ℕ} (hq : 1 ≤ q) (hj : j < m) :
    (multsMask q m).testBit (q * (j + 1)) = true := by
  rw [multsMask_eq_shift hq, Nat.testBit_shiftLeft]
  have hge : q ≤ q * (j + 1) := Nat.le_mul_of_pos_right q (by omega)
  have hsub : q * (j + 1) - q = q * j := by
    rw [Nat.mul_succ]
    omega
  simp only [hge, decide_true, Bool.true_and, hsub]
  exact testBit_periodicMask_of_lt hq m j hj

lemma foldl_or_mono {α : Type*} (f : α → ℕ) (L : List α) :
    ∀ (acc k : ℕ), acc.testBit k = true →
      (L.foldl (fun a x => a ||| f x) acc).testBit k = true := by
  induction L with
  | nil => intro acc k h; exact h
  | cons x xs ih =>
    intro acc k h
    simp only [List.foldl_cons]
    apply ih
    rw [Nat.testBit_or, h, Bool.true_or]

lemma foldl_or_of_mem {α : Type*} (f : α → ℕ) (L : List α) :
    ∀ (acc k : ℕ) {x : α}, x ∈ L → (f x).testBit k = true →
      (L.foldl (fun a y => a ||| f y) acc).testBit k = true := by
  induction L with
  | nil => intro _ _ _ hx _; cases hx
  | cons y ys ih =>
    intro acc k x hx htb
    simp only [List.foldl_cons]
    rcases List.mem_cons.mp hx with rfl | hmem
    · apply foldl_or_mono
      rw [Nat.testBit_or, htb, Bool.or_true]
    · exact ih (acc ||| f y) k hmem htb

