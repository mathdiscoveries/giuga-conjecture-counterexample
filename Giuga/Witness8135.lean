    IsNormalOddPrimeSet greedySet8135 ∧
      greedySet8135.card = 8135 ∧
      (∀ p ∈ greedySet8135, 5 ≤ p ∧ p ≤ 321053) ∧
      (1 : ℚ) < (∑ p ∈ greedySet8135, (1 : ℚ) / (p : ℚ)) ∧
      (1 : ℝ) < (∑ p ∈ greedySet8135, (1 : ℝ) / (p : ℝ)) ∧
      10 ^ 40732 < (∏ p ∈ greedySet8135, p) ∧
      (∏ p ∈ greedySet8135, p) < 10 ^ 40733 := by
  obtain ⟨h1, h2, h3, h4, h5, h6, h7⟩ :=
    (bundle_extract (by decide)
