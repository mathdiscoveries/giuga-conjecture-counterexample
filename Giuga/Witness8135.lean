/-! ### Part 2: 20-Bit Packed Witness Evaluator & Parallel Finset Soundness -/

/-- Packed 8,135 half-primes `k = (p - 1) / 2` (20 bits each, little-endian, sorted ascending). -/
def packedK8135 : ℕ :=
  

/-- Summary statistics accumulated across a binary tree over packed 20-bit half-primes. -/
structure PackStats where
  minP : ℕ
  maxP : ℕ
  setMask : ℕ
  confMask : ℕ
  recipLo : ℕ
  recipHi : ℕ
  prodVal : ℕ
  k3 : ℕ
  sortedOk : Bool

/-- Parallel binary-tree evaluator of `cnt` 20-bit half-primes at tree depth `d`. -/
def evalPacked : ℕ → ℕ → ℕ → PackStats
  | 0, cnt, words =>
    if cnt == 0 then ⟨0, 0, 0, 0, 0, 0, 1, 0, true⟩
    else
      let k := words &&& 0xFFFFF
      let p := 2 * k + 1
      let m := 160571 / p
      let scale := 1 <<< 60
      ⟨p, p, 1 <<< k, multsMask p m, scale / p, (scale + p - 1) / p, p,
       if p % 4 == 3 then 1 else 0, decide (1 ≤ k ∧ k ≤ 160526)⟩
  | d + 1, cnt, words =>
    if cnt == 0 then ⟨0, 0, 0, 0, 0, 0, 1, 0, true⟩
    else
      let half := 1 <<< d
      if cnt ≤ half then evalPacked d cnt words
      else
        let shift := 20 * half
        let lowW := words &&& ((1 <<< shift) - 1)
        let highW := words >>> shift
        let sL := evalPacked d half lowW
        let sR := evalPacked d (cnt - half) highW
        ⟨sL.minP, sR.maxP, sL.setMask ||| sR.setMask, sL.confMask ||| sR.confMask,
         sL.recipLo + sR.recipLo, sL.recipHi + sR.recipHi,
         sL.prodVal * sR.prodVal, sL.k3 + sR.k3,
         sL.sortedOk && sR.sortedOk && decide (sL.maxP < sR.minP)⟩

/-- Mathematical `Finset ℕ` mirrored structurally along the binary tree of `evalPacked`. -/
def packSet : ℕ → ℕ → ℕ → Finset ℕ
  | 0, cnt, words =>
    if cnt == 0 then ∅
    else {2 * (words &&& 0xFFFFF) + 1}
  | d + 1, cnt, words =>
    if cnt == 0 then ∅
    else
      let half := 1 <<< d
      if cnt ≤ half then packSet d cnt words
      else
        let shift := 20 * half
        let lowW := words &&& ((1 <<< shift) - 1)
        let highW := words >>> shift
        packSet d half lowW ∪ packSet d (cnt - half) highW

lemma evalPacked_sound (d : ℕ) :
    ∀ (cnt words : ℕ), 1 ≤ cnt → cnt ≤ 2 ^ d →
      let st := evalPacked d cnt words
      let S := packSet d cnt words
      st.sortedOk = true →
        S.card = cnt ∧
        (∀ p ∈ S, st.minP ≤ p ∧ p ≤ st.maxP ∧ Odd p ∧ 3 ≤ p ∧ p ≤ 321053 ∧
          st.setMask.testBit ((p - 1) / 2) = true ∧
          (∀ j < 160571 / p, st.confMask.testBit (p * (j + 1)) = true)) ∧
        (∀ i : ℕ, st.setMask.testBit i = true → 2 * i + 1 ∈ S) ∧
        (∏ p ∈ S, p) = st.prodVal ∧
        (S.filter (fun p => p % 4 = 3)).card = st.k3 ∧
        (st.recipLo : ℚ) / ((1 <<< 60 : ℕ) : ℚ) ≤ (∑ p ∈ S, (1 : ℚ) / (p : ℚ)) ∧
        (∑ p ∈ S, (1 : ℚ) / (p : ℚ)) ≤ (st.recipHi : ℚ) / ((1 <<< 60 : ℕ) : ℚ) := by
  induction d with
  | zero =>
    intro cnt words h1 hle
    have hcnt1 : cnt = 1 := by
      have : 2 ^ 0 = 1 := rfl
      omega
    subst hcnt1
    unfold evalPacked packSet
    simp only [beq_iff_eq, Nat.one_ne_zero, ↓reduceIte]
    set k := words &&& 0xFFFFF
    set p := 2 * k + 1
    set scale := (1 <<< 60 : ℕ)
    intro hok
    simp only [decide_eq_true_eq] at hok
    rcases hok with ⟨hk1, hkle⟩
    have hp3 : 3 ≤ p := by omega
    have hple : p ≤ 321053 := by omega
    have hk_eq : (p - 1) / 2 = k := by omega
    have hscale_pos : (0 : ℚ) < (scale : ℚ) := by
      have : 0 < scale := by decide
      exact_mod_cast this
    have hp_posQ : (0 : ℚ) < (p : ℚ) := by exact_mod_cast (by omega : 0 < p)
    refine ⟨Finset.card_singleton p, ?_, ?_, Finset.prod_singleton _ _, ?_, ?_, ?_⟩
    · intro x hx
      rw [Finset.mem_singleton.mp hx]
      refine ⟨le_rfl, le_rfl, ⟨k, rfl⟩, hp3, hple, ?_, ?_⟩
      · rw [hk_eq, Nat.one_shiftLeft, Nat.testBit_two_pow_self]
      · intro j hj
        exact testBit_multsMask_of_lt (by omega) hj
    · intro i htb
      rw [Nat.one_shiftLeft, Nat.testBit_two_pow] at htb
      simp only [decide_eq_true_eq] at htb
      subst htb
      exact Finset.mem_singleton_self p
    · by_cases hp4 : p % 4 = 3
      · simp only [Finset.filter_singleton, hp4, ↓reduceIte, Finset.card_singleton]
      · simp only [Finset.filter_singleton, hp4, ↓reduceIte, Finset.card_empty]
    · rw [Finset.sum_singleton, div_le_div_iff₀ hscale_pos hp_posQ, one_mul]
      have hmul_le : (scale / p) * p ≤ scale := Nat.div_mul_le_self scale p
      exact_mod_cast hmul_le
    · rw [Finset.sum_singleton, div_le_div_iff₀ hp_posQ hscale_pos, one_mul]
      set q := (scale + p - 1) / p
      have hmul_ge : scale ≤ q * p := by
        have h1 : p * q + (scale + p - 1) % p = scale + p - 1 :=
          Nat.div_add_mod (scale + p - 1) p
        have h2 := Nat.mod_lt (scale + p - 1) (by omega : 0 < p)
        rw [mul_comm] at h1
        generalize q * p = m at h1 ⊢
        omega
      exact_mod_cast hmul_ge
  | succ d ih =>
    intro cnt words h1 hle
    unfold evalPacked packSet
    have hne0 : (cnt == 0) = false := beq_false_of_ne (by omega)
    simp only [hne0, Bool.false_eq_true, ↓reduceIte]
    set half := 1 <<< d
    have hhalf_eq : half = 2 ^ d := by simp [half, Nat.one_shiftLeft]
    by_cases hch : cnt ≤ half
    · simp only [hch, ↓reduceIte]
      exact ih cnt words h1 (hhalf_eq ▸ hch)
    · simp only [hch, ↓reduceIte]
      set shift := 20 * half
      set lowW := words &&& ((1 <<< shift) - 1)
      set highW := words >>> shift
      intro hok
      simp only [Bool.and_eq_true, decide_eq_true_eq] at hok
      rcases hok with ⟨⟨hokL, hokR⟩, hlt_minmax⟩
      have hhalf_pos : 1 ≤ half := by
        rw [hhalf_eq]
        exact Nat.one_le_two_pow
      have h2d1 : 2 ^ (d + 1) = half + half := by
        rw [pow_succ, mul_two, hhalf_eq]
      have hrem_pos : 1 ≤ cnt - half := by omega
      have hrem_le : cnt - half ≤ 2 ^ d := by omega
      obtain ⟨hcardL, hmemL, hconvL, hprodL, hk3L, hloL, hhiL⟩ :=
        ih half lowW hhalf_pos (le_of_eq hhalf_eq) hokL
      obtain ⟨hcardR, hmemR, hconvR, hprodR, hk3R, hloR, hhiR⟩ :=
        ih (cnt - half) highW hrem_pos hrem_le hokR
      set sL := evalPacked d half lowW
      set sR := evalPacked d (cnt - half) highW
      set SL := packSet d half lowW
      set SR := packSet d (cnt - half) highW
      obtain ⟨xL, hxL⟩ : SL.Nonempty := Finset.card_pos.mp (by omega)
      obtain ⟨xR, hxR⟩ : SR.Nonempty := Finset.card_pos.mp (by omega)
      have hmin_le_maxL : sL.minP ≤ sL.maxP :=
        le_trans (hmemL xL hxL).1 (hmemL xL hxL).2.1
      have hmin_le_maxR : sR.minP ≤ sR.maxP :=
        le_trans (hmemR xR hxR).1 (hmemR xR hxR).2.1
      have hdisj : Disjoint SL SR := by
        rw [Finset.disjoint_left]
        intro p hpL hpR
        have h1' := (hmemL p hpL).2.1
        have h2' := (hmemR p hpR).1
        omega
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · rw [Finset.card_union_of_disjoint hdisj, hcardL, hcardR]
        omega
      · intro p hp
        rcases Finset.mem_union.mp hp with hpL | hpR
        · obtain ⟨hmin, hmax, hodd, hp3, hple, hset, hconf⟩ := hmemL p hpL
          refine ⟨hmin, by omega, hodd, hp3, hple, ?_, ?_⟩
          · rw [Nat.testBit_or, hset, Bool.true_or]
          · intro j hj
            rw [Nat.testBit_or, hconf j hj, Bool.true_or]
        · obtain ⟨hmin, hmax, hodd, hp3, hple, hset, hconf⟩ := hmemR p hpR
          refine ⟨by omega, hmax, hodd, hp3, hple, ?_, ?_⟩
          · rw [Nat.testBit_or, hset, Bool.or_true]
          · intro j hj
            rw [Nat.testBit_or, hconf j hj, Bool.or_true]
      · intro i htb
        rw [Nat.testBit_or, Bool.or_eq_true] at htb
        rcases htb with hL | hR
        · exact Finset.mem_union_left _ (hconvL i hL)
        · exact Finset.mem_union_right _ (hconvR i hR)
      · rw [Finset.prod_union hdisj, hprodL, hprodR]
      · have hdisj_f :
            Disjoint (SL.filter (fun p => p % 4 = 3)) (SR.filter (fun p => p % 4 = 3)) :=
          Finset.disjoint_filter_filter hdisj
        rw [Finset.filter_union, Finset.card_union_of_disjoint hdisj_f, hk3L, hk3R]
      · rw [Finset.sum_union hdisj, Nat.cast_add, add_div]
        exact add_le_add hloL hloR
      · rw [Finset.sum_union hdisj, Nat.cast_add, add_div]
        exact add_le_add hhiL hhiR

/-! ### Part 3: Single-Pass Kernel Verification & Unconditional Witness Theorems -/

/-- Bitmask of the 7 odd prime factors `(3, 167, 211, 499, 761, 6689, 26759)` of `r - 1`
for `r ∈ (321073, 321109, 321143, 1999993)`. -/
def forbidFactors7Mask : ℕ :=
  (1 <<< 1) ||| (1 <<< 83) ||| (1 <<< 105) ||| (1 <<< 249) |||
    (1 <<< 380) ||| (1 <<< 3344) ||| (1 <<< 13379)

/-- Bitmask of `(167, 211, 499, 761, 6689, 26759, 321073, 321109, 321143)` verified prime. -/
def extraPrimes5Mask : ℕ :=
  (1 <<< 83) ||| (1 <<< 105) ||| (1 <<< 249) ||| (1 <<< 380) |||
    (1 <<< 3344) ||| (1 <<< 13379) ||| (1 <<< 160536) |||
    (1 <<< 160554) ||| (1 <<< 160571)

/-- Unified Boolean verifier checking all properties of both `G_8135` and `W_8138` in one pass. -/
def checkWitnessBundle (d sieveMask packed pow32 pow33 pow50 pow51 : ℕ) : Bool :=
  let st := evalPacked d 8135 packed
  let scale := 1 <<< 60
  let mul4 := 321073 * 321109 * 321143 * 1999993
  let addLo4 := scale / 321073 + scale / 321109 + scale / 321143 + scale / 1999993
  let addHi4 := (scale + 321072) / 321073 + (scale + 321108) / 321109 +
    (scale + 321142) / 321143 + (scale + 1999992) / 1999993
  let remHi := (scale + 97386) / 97387
  let remLo := scale / 97387
  st.sortedOk &&
  (st.minP == 5) &&
  (st.maxP == 321053) &&
  (((st.setMask ||| extraPrimes5Mask) &&& (1 ||| sieveMask)) == 0) &&
  ((st.setMask &&& st.confMask) == 0) &&
  (st.setMask.testBit 48693 == true) &&
  ((st.setMask &&& forbidFactors7Mask) == 0) &&
  decide (scale < st.recipLo) &&
  (st.k3 == 4032) &&
  decide (pow32 < st.prodVal) &&
  decide (st.prodVal < pow33) &&
  decide (scale + remHi < st.recipLo + addLo4) &&
  decide ((st.recipHi + addHi4 - remLo - scale) * 1999993 < scale) &&
  decide (97387 * pow50 < st.prodVal * mul4) &&
  decide (st.prodVal * mul4 < 97387 * pow51)

/-- Pure-kernel `rfl` verification of the 8,135-prime and 8,138-prime witnesses (zero `native_decide`). -/
lemma checkWitnessBundle_eq_true :
    checkWitnessBundle 13 sieveComp321145 packedK8135
      ((10 ^ 200) ^ 203 * (10 ^ 132))
      ((10 ^ 200) ^ 203 * (10 ^ 133))
      ((10 ^ 200) ^ 203 * (10 ^ 150))
      ((10 ^ 200) ^ 203 * (10 ^ 151)) = true := rfl

/-- Construct the 7-rule ceiling witness from any candidate set `G` by replacing `97,387`. -/
def ceilingWitnessFrom (G : Finset ℕ) : Finset ℕ :=
  insert 1999993 (insert 321143 (insert 321109 (insert 321073 (G.erase 97387))))

/-- The explicit 8,135-element greedy normal odd prime set from `(5, 7, 13)` at cut `17`. -/
def greedySet8135 : Finset ℕ :=
  packSet 13 8135 packedK8135

/-- The explicit 8,138-element 7-rule ceiling witness `W` of Theorem 3(c). -/
def ceilingWitness8138 : Finset ℕ :=
  ceilingWitnessFrom greedySet8135

lemma testBit_zero_of_and_eq_zero {a b i : ℕ} (h : (a &&& b) = 0) (ha : a.testBit i = true) :
    b.testBit i = false := by
  cases hb : b.testBit i
  · rfl
  · have hand : (a &&& b).testBit i = true := by
      rw [Nat.testBit_and, ha, hb, Bool.and_self]
    rw [h, Nat.zero_testBit] at hand
    cases hand

lemma bundle_extract {d sieveMask packed pow32 pow33 pow50 pow51 : ℕ}
    (hd : 8135 ≤ 2 ^ d)
    (hsieve : ∀ k : ℕ, 2 ≤ k → k ≤ 160571 → sieveMask.testBit k = false → Nat.Prime (2 * k + 1))
    (hc : checkWitnessBundle d sieveMask packed pow32 pow33 pow50 pow51 = true) :
    let G := packSet d 8135 packed
    let W := ceilingWitnessFrom G
    (IsNormalOddPrimeSet G ∧
      G.card = 8135 ∧
      (∀ p ∈ G, 5 ≤ p ∧ p ≤ 321053) ∧
      (1 : ℚ) < (∑ p ∈ G, (1 : ℚ) / (p : ℚ)) ∧
      (1 : ℝ) < (∑ p ∈ G, (1 : ℝ) / (p : ℝ)) ∧
      pow32 < (∏ p ∈ G, p) ∧
      (∏ p ∈ G, p) < pow33) ∧
    (IsNormalOddPrimeSet W ∧
      W.card = 8138 ∧
      (∀ p ∈ W, 5 ≤ p ∧ p ≤ 1999993) ∧
      (1 : ℚ) < (∑ p ∈ W, (1 : ℚ) / (p : ℚ)) ∧
      (1 : ℝ) < (∑ p ∈ W, (1 : ℝ) / (p : ℝ)) ∧
      (∀ p ∈ W, (∑ q ∈ W.erase p, (1 : ℝ) / (q : ℝ)) ≤ 1) ∧
      (W.filter (fun p => p % 4 = 3)).card = 4032 ∧
      (∑ p ∈ W, p) ≡ 1 + (∏ p ∈ W, p) [MOD 8] ∧
      pow50 < (∏ p ∈ W, p) ∧
      (∏ p ∈ W, p) < pow51) := by
  unfold checkWitnessBundle at hc
  have hsound_raw := evalPacked_sound d 8135 packed (by decide) hd
  set st := evalPacked d 8135 packed
  set G := packSet d 8135 packed
  set scale := (1 <<< 60 : ℕ)
  set mul4 := 321073 * 321109 * 321143 * 1999993
  set addLo4 := scale / 321073 + scale / 321109 + scale / 321143 + scale / 1999993
  set addHi4 := (scale + 321072) / 321073 + (scale + 321108) / 321109 +
    (scale + 321142) / 321143 + (scale + 1999992) / 1999993
  set remHi := (scale + 97386) / 97387
  set remLo := scale / 97387
  simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hc
  rcases hc with ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨hsok, hmin5⟩, hmaxP⟩, hsieve0⟩, hconf0⟩,
    h97387_bit⟩, hforb0⟩, hrecipG⟩, hk3G⟩, hprodG_lo⟩, hprodG_hi⟩,
    hrecipW_lo⟩, hrecipW_exact⟩, hprodW_lo⟩, hprodW_hi⟩
  obtain ⟨hcardG, hmemG, hconvG, hprodG, hfiltG, hqLoG, hqHiG⟩ := hsound_raw hsok
  have hG_bounds : ∀ p ∈ G, 5 ≤ p ∧ p ≤ 321053 := by
    intro p hp
    have hm := hmemG p hp
    exact ⟨hmin5 ▸ hm.1, hmaxP ▸ hm.2.1⟩
  have hG_prime_odd : ∀ p ∈ G, Nat.Prime p ∧ Odd p := by
    intro p hp
    obtain ⟨_, _, hodd, _, _, htb, _⟩ := hmemG p hp
    obtain ⟨hp5, hple⟩ := hG_bounds p hp
    set k := (p - 1) / 2
    have hp_eq : 2 * k + 1 = p := by rcases hodd with ⟨t, hpt⟩; dsimp only [k]; omega
    have hk_ge2 : 2 ≤ k := by dsimp only [k]; omega
    have hk_le : k ≤ 160571 := by dsimp only [k]; omega
    have hor : (st.setMask ||| extraPrimes5Mask).testBit k = true := by
      rw [Nat.testBit_or, htb, Bool.true_or]
    have hfalse1 := testBit_zero_of_and_eq_zero hsieve0 hor
    rw [Nat.testBit_or, Bool.or_eq_false_iff] at hfalse1
    have hpr : Nat.Prime (2 * k + 1) := hsieve k hk_ge2 hk_le hfalse1.2
    exact ⟨hp_eq ▸ hpr, hodd⟩
  have hG_norm : IsNormalOddPrimeSet G := by
    refine ⟨hG_prime_odd, ?_⟩
    intro p hp r hr hlt hdvd
    obtain ⟨hpr_p, hodd_p⟩ := hG_prime_odd p hp
    obtain ⟨_, hodd_r⟩ := hG_prime_odd r hr
    obtain ⟨hp5, _⟩ := hG_bounds p hp
    obtain ⟨hr5, hrle⟩ := hG_bounds r hr
    rcases hodd_p with ⟨tp, htp⟩
    rcases hodd_r with ⟨tr, htr⟩
    set kr := (r - 1) / 2
    have hkr_pos : 1 ≤ kr := by dsimp only [kr]; omega
    have hkr_le : kr ≤ 160526 := by dsimp only [kr]; omega
    have hr1 : r - 1 = 2 * kr := by dsimp only [kr]; omega
    rw [hr1, mul_comm] at hdvd
    have hcop : Nat.Coprime p 2 := hpr_p.coprime_iff_not_dvd.mpr fun h2 => by
      have := Nat.le_of_dvd (by decide : 0 < 2) h2
      omega
    have hp_dvd_kr : p ∣ kr := hcop.dvd_of_dvd_mul_right hdvd
    rcases hp_dvd_kr with ⟨m, hm⟩
    have hm_pos : 1 ≤ m := by
      rcases m with _ | m'
      · rw [Nat.mul_zero] at hm; omega
      · omega
    set j := m - 1
    have hmj : m = j + 1 := by dsimp only [j]; omega
    have hkr_eq : kr = p * (j + 1) := by rw [hm, hmj]
    have hj_lt : j < 160571 / p := by
      have hpj : (j + 1) * p ≤ 160571 := by rw [mul_comm, ← hkr_eq]; omega
      have hle_div : j + 1 ≤ 160571 / p :=
        (Nat.le_div_iff_mul_le (by omega : 0 < p)).mpr hpj
      omega
    have hconf_bit : st.confMask.testBit kr = true := by
      rw [hkr_eq]
      exact (hmemG p hp).2.2.2.2.2.2 j hj_lt
    have hset_bit : st.setMask.testBit kr = true := (hmemG r hr).2.2.2.2.2.1
    have hfalse := testBit_zero_of_and_eq_zero hconf0 hset_bit
    rw [hconf_bit] at hfalse
    cases hfalse
  have hscale_pos : (0 : ℚ) < (scale : ℚ) := by
    have : 0 < scale := by decide
    exact_mod_cast this
  have hG_sumQ : (1 : ℚ) < ∑ p ∈ G, (1 : ℚ) / (p : ℚ) := by
    have hltQ : (scale : ℚ) / (scale : ℚ) < (st.recipLo : ℚ) / (scale : ℚ) :=
      div_lt_div_of_pos_right (by exact_mod_cast hrecipG) hscale_pos
    rw [div_self (ne_of_gt hscale_pos)] at hltQ
    exact lt_of_lt_of_le hltQ hqLoG
  have hG_sumR : (1 : ℝ) < ∑ p ∈ G, (1 : ℝ) / (p : ℝ) := by
    have hcast := Rat.cast_lt (K := ℝ).mpr hG_sumQ
    simpa [Rat.cast_sum, Rat.cast_div, Rat.cast_natCast] using hcast
  have hG_prod_lo : pow32 < ∏ p ∈ G, p := by
    rw [hprodG]
    exact hprodG_lo
  have hG_prod_hi : (∏ p ∈ G, p) < pow33 := by
    rw [hprodG]
    exact hprodG_hi
  -- Part B: Witness W = (G \ {97387}) ∪ {321073, 321109, 321143, 1999993}
  have hextra_bit : ∀ k : ℕ, extraPrimes5Mask.testBit k = true → sieveMask.testBit k = false := by
    intro k hk
    have hor : (st.setMask ||| extraPrimes5Mask).testBit k = true := by
      rw [Nat.testBit_or, hk, Bool.or_true]
    have hf := testBit_zero_of_and_eq_zero hsieve0 hor
    rw [Nat.testBit_or, Bool.or_eq_false_iff] at hf
    exact hf.2
  have hpr_167 : Nat.Prime 167 :=
    hsieve 83 (by decide) (by decide) (hextra_bit 83 (by decide))
  have hpr_211 : Nat.Prime 211 :=
    hsieve 105 (by decide) (by decide) (hextra_bit 105 (by decide))
  have hpr_499 : Nat.Prime 499 :=
    hsieve 249 (by decide) (by decide) (hextra_bit 249 (by decide))
  have hpr_761 : Nat.Prime 761 :=
    hsieve 380 (by decide) (by decide) (hextra_bit 380 (by decide))
  have hpr_6689 : Nat.Prime 6689 :=
    hsieve 3344 (by decide) (by decide) (hextra_bit 3344 (by decide))
  have hpr_26759 : Nat.Prime 26759 :=
    hsieve 13379 (by decide) (by decide) (hextra_bit 13379 (by decide))
  have hpr_321073 : Nat.Prime 321073 :=
    hsieve 160536 (by decide) (by decide) (hextra_bit 160536 (by decide))
  have hpr_321109 : Nat.Prime 321109 :=
    hsieve 160554 (by decide) (by decide) (hextra_bit 160554 (by decide))
  have hpr_321143 : Nat.Prime 321143 :=
    hsieve 160571 (by decide) (by decide) (hextra_bit 160571 (by decide))
  have hpr_1999993 : Nat.Prime 1999993 := prime_1999993
  have hnot_forb : ∀ k : ℕ, forbidFactors7Mask.testBit k = true → (2 * k + 1) ∉ G := by
    intro k hk hmem
    have hset := (hmemG (2 * k + 1) hmem).2.2.2.2.2.1
    have hk_eq : (2 * k + 1 - 1) / 2 = k := by omega
    rw [hk_eq] at hset
    have hf := testBit_zero_of_and_eq_zero hforb0 hset
    rw [hk] at hf
    cases hf
  have hn3 : 3 ∉ G := hnot_forb 1 (by decide)
  have hn167 : 167 ∉ G := hnot_forb 83 (by decide)
  have hn211 : 211 ∉ G := hnot_forb 105 (by decide)
  have hn499 : 499 ∉ G := hnot_forb 249 (by decide)
  have hn761 : 761 ∉ G := hnot_forb 380 (by decide)
  have hn6689 : 6689 ∉ G := hnot_forb 3344 (by decide)
  have hn26759 : 26759 ∉ G := hnot_forb 13379 (by decide)
  set Gplus := insert 1999993 (insert 321143 (insert 321109 (insert 321073 G)))
  have hmem_Gplus : ∀ x : ℕ, x ∈ Gplus ↔
      x = 1999993 ∨ x = 321143 ∨ x = 321109 ∨ x = 321073 ∨ x ∈ G := by
    intro x
    simp only [Gplus, Finset.mem_insert]
  have hGplus_norm : IsNormalOddPrimeSet Gplus := by
    refine ⟨?_, ?_⟩
    · intro x hx
      rcases (hmem_Gplus x).mp hx with rfl | rfl | rfl | rfl | hxG
      · exact ⟨hpr_1999993, ⟨999996, rfl⟩⟩
      · exact ⟨hpr_321143, ⟨160571, rfl⟩⟩
      · exact ⟨hpr_321109, ⟨160554, rfl⟩⟩
      · exact ⟨hpr_321073, ⟨160536, rfl⟩⟩
      · exact hG_prime_odd x hxG
    · intro p hp r hr hlt hdvd
      have hp_pr : Nat.Prime p := by
        rcases (hmem_Gplus p).mp hp with rfl | rfl | rfl | rfl | hpG
        · exact hpr_1999993
        · exact hpr_321143
        · exact hpr_321109
        · exact hpr_321073
        · exact (hG_prime_odd p hpG).1
      have hp_odd : Odd p := by
        rcases (hmem_Gplus p).mp hp with rfl | rfl | rfl | rfl | hpG
        · exact ⟨999996, rfl⟩
        · exact ⟨160571, rfl⟩
        · exact ⟨160554, rfl⟩
        · exact ⟨160536, rfl⟩
        · exact (hG_prime_odd p hpG).2
      have hp_ndvd2 : ¬ (p ∣ 2) := fun h2 => by
        have hp2 := Nat.le_of_dvd (by decide : 0 < 2) h2
        have hp_ge2 := hp_pr.two_le
        rcases hp_odd with ⟨t, ht⟩
        omega
      rcases (hmem_Gplus r).mp hr with rfl | rfl | rfl | rfl | hrG
      · rcases (hmem_Gplus p).mp hp with rfl | rfl | rfl | rfl | hpG
        · omega
        · omega
        · omega
        · omega
        · have hf : 1999993 - 1 = 2 ^ 3 * (3 * (167 * 499)) := by decide
          rw [hf] at hdvd
          rcases hp_pr.dvd_mul.mp hdvd with h2p | hrest
          · exact hp_ndvd2 (hp_pr.dvd_of_dvd_pow h2p)
          · rcases hp_pr.dvd_mul.mp hrest with h3 | hrest2
            · rcases (Nat.prime_dvd_prime_iff_eq hp_pr (by decide)).mp h3 with rfl
              exact hn3 hpG
            · rcases hp_pr.dvd_mul.mp hrest2 with h167 | h499
              · rcases (Nat.prime_dvd_prime_iff_eq hp_pr hpr_167).mp h167 with rfl
                exact hn167 hpG
              · rcases (Nat.prime_dvd_prime_iff_eq hp_pr hpr_499).mp h499 with rfl
                exact hn499 hpG
      · rcases (hmem_Gplus p).mp hp with rfl | rfl | rfl | rfl | hpG
        · omega
        · omega
        · omega
        · omega
        · have hf : 321143 - 1 = 2 * (211 * 761) := by decide
          rw [hf] at hdvd
          rcases hp_pr.dvd_mul.mp hdvd with h2 | hrest
          · exact hp_ndvd2 h2
          · rcases hp_pr.dvd_mul.mp hrest with h211 | h761
            · rcases (Nat.prime_dvd_prime_iff_eq hp_pr hpr_211).mp h211 with rfl
              exact hn211 hpG
            · rcases (Nat.prime_dvd_prime_iff_eq hp_pr hpr_761).mp h761 with rfl
              exact hn761 hpG
      · rcases (hmem_Gplus p).mp hp with rfl | rfl | rfl | rfl | hpG
        · omega
        · omega
        · omega
        · omega
        · have hf : 321109 - 1 = 2 ^ 2 * (3 * 26759) := by decide
          rw [hf] at hdvd
          rcases hp_pr.dvd_mul.mp hdvd with h2p | hrest
          · exact hp_ndvd2 (hp_pr.dvd_of_dvd_pow h2p)
          · rcases hp_pr.dvd_mul.mp hrest with h3 | h26759
            · rcases (Nat.prime_dvd_prime_iff_eq hp_pr (by decide)).mp h3 with rfl
              exact hn3 hpG
            · rcases (Nat.prime_dvd_prime_iff_eq hp_pr hpr_26759).mp h26759 with rfl
              exact hn26759 hpG
      · rcases (hmem_Gplus p).mp hp with rfl | rfl | rfl | rfl | hpG
        · omega
        · omega
        · omega
        · omega
        · have hf : 321073 - 1 = 2 ^ 4 * (3 * 6689) := by decide
          rw [hf] at hdvd
          rcases hp_pr.dvd_mul.mp hdvd with h2p | hrest
          · exact hp_ndvd2 (hp_pr.dvd_of_dvd_pow h2p)
          · rcases hp_pr.dvd_mul.mp hrest with h3 | h6689
            · rcases (Nat.prime_dvd_prime_iff_eq hp_pr (by decide)).mp h3 with rfl
              exact hn3 hpG
            · rcases (Nat.prime_dvd_prime_iff_eq hp_pr hpr_6689).mp h6689 with rfl
              exact hn6689 hpG
      · have hr_le : r ≤ 321053 := (hG_bounds r hrG).2
        rcases (hmem_Gplus p).mp hp with rfl | rfl | rfl | rfl | hpG
        · omega
        · omega
        · omega
        · omega
        · exact hG_norm.2 p hpG r hrG hlt hdvd
  set G0 := G.erase 97387
  set W := ceilingWitnessFrom G
  have hW_def : W = insert 1999993 (insert 321143 (insert 321109 (insert 321073 G0))) := rfl
  have h97387_mem : 97387 ∈ G := by
    have := hconvG 48693 h97387_bit
    simpa using this
  have hG0_le : ∀ x ∈ G0, x ≤ 321053 := fun x hx =>
