      8135 ≤ P.card) ∧
      ∃ G : Finset ℕ, IsNormalOddPrimeSet G ∧
        (1 : ℝ) < (∑ p ∈ G, (1 : ℝ) / (p : ℝ)) ∧ G.card = 8135 := by
  refine ⟨hN1, ?_⟩
