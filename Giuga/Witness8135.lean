def sieveComp321145 : ℕ :=
  smallOddPrimes102.foldl
    (fun acc q => acc ||| ((periodicMask q (160573 / q + 1)) <<< ((q * q - 1) / 2))) 0

/-- Binary-tree range universal check over `[lo, lo + 2^d)` (`O(d)` stack depth). -/
def allRangePow2 (f : ℕ → Bool) : ℕ → ℕ → Bool
  | 0, lo => f lo
  | d + 1, lo => allRangePow2 f d lo && allRangePow2 f d (lo + (1 <<< d))

lemma allRangePow2_sound (f : ℕ → Bool) (d : ℕ) :
    ∀ (lo x : ℕ), allRangePow2 f d lo = true → lo ≤ x → x < lo + 2 ^ d → f x = true := by
  induction d with
  | zero =>
    intro lo x h hlo hhi
    have hx : x = lo := by
      have : 2 ^ 0 = 1 := rfl
      omega
    subst hx
    exact h
  | succ d ih =>
    intro lo x h hlo hhi
    unfold allRangePow2 at h
    rw [Bool.and_eq_true] at h
    have hsh : 1 <<< d = 2 ^ d := by simp [Nat.one_shiftLeft]
    rw [hsh] at h
    have h2 : 2 ^ (d + 1) = 2 ^ d + 2 ^ d := by rw [pow_succ, mul_two]
    rcases lt_or_ge x (lo + 2 ^ d) with hlt | hge
    · exact ih lo x h.1 hlo hlt
    · exact ih (lo + 2 ^ d) x h.2 hge (by omega)

